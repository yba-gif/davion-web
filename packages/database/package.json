{
    "name": "@base1/database",
    "version": "1.0.0",
    "main": "src/index.ts",
    "types": "src/index.ts",
    "scripts": {
        "build": "tsc",
        "db:generate": "drizzle-kit generate",
        "db:generate:prod": "dotenv -e ../../.env -- drizzle-kit generate",
        "db:migrate": "tsx src/migrate.ts",
        "db:migrate:prod": "dotenv -e ../../.env -- tsx src/migrate.ts",
        "db:push": "drizzle-kit push",
        "db:push:prod": "dotenv -e ../../.env -- drizzle-kit push",
        "db:studio": "drizzle-kit studio",
        "db:studio:prod": "dotenv -e ../../.env -- drizzle-kit studio",
        "db:test:neon": "tsx src/test-neon.ts"
    },
    "dependencies": {
        "@neondatabase/serverless": "^1.1.0",
        "@types/uuid": "^10.0.0",
        "dotenv": "^17.2.0",
        "drizzle-orm": "^0.44.3",
        "pg": "^8.11.3",
        "postgres": "^3.4.3",
        "uuid": "^11.1.0"
    },
    "devDependencies": {
        "@types/pg": "^8.15.4",
        "drizzle-kit": "^0.31.4",
        "tsx": "^4.0.0",
        "typescript": "^5.8.3"
    }
}
