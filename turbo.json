{
    "$schema": "https://turbo.build/schema.json",
    "globalEnv": [
        "NODE_ENV",
        "DATABASE_URL",
        "POSTGRES_DB",
        "POSTGRES_USER",
        "POSTGRES_PASSWORD",
        "MINIO_ROOT_USER",
        "MINIO_ROOT_PASSWORD",
        "MINIO_ENDPOINT",
        "MINIO_PORT",
        "MINIO_ACCESS_KEY",
        "MINIO_SECRET_KEY",
        "MINIO_USE_SSL",
        "MINIO_PUBLIC_URL",
        "MINIO_API_CORS_ALLOW_ORIGIN",
        "PORT",
        "ROOT_SECRET_KEY",
        "WEB_URL",
        "ADMIN_URL"
    ],
    "pipeline": {
        "build": {
            "dependsOn": ["^build"],
            "outputs": [".next/**", "dist/**", ".output/**"]
        },
        "dev": {
            "cache": false,
            "persistent": true
        },
        "dev:add-data-source": {
            "cache": false
        },
        "lint": {},
        "test": {
            "dependsOn": ["^build"]
        },
        "db:generate": {
            "cache": false
        },
        "db:migrate": {
            "cache": false
        },
        "db:studio": {
            "cache": false,
            "persistent": true
        }
    }
}
